# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. See SETUP.md for where to find each value.

# Public URL of the site (used in emails, sitemap, social previews)
NEXT_PUBLIC_SITE_URL=https://www.realvaluepromoters.com

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Lets production deploys apply new database migrations automatically
# (scripts/migrate.mjs). Supabase → Connect → Session pooler string, with your
# DB password filled in. Vercel: Production ONLY, marked Sensitive.
# Leave it unset locally and on Preview.
# SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Resend → API Keys (needs "Sending access")
RESEND_API_KEY=re_...
# Must use the domain you verified in Resend
RESEND_FROM_EMAIL="Real Value Promoters <enquiries@realvaluepromoters.com>"
# Who gets new-lead emails. Comma-separate several addresses.
LEADS_NOTIFY_EMAIL=realvaluelandpromoters@gmail.com

# Optional: any long random string, used to anonymise IPs for rate limiting
LEAD_HASH_SALT=
